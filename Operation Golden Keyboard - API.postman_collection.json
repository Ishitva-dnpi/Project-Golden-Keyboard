    {
      "name": "3. Session Authentication",
      "item": [
        {
          "name": "Login (pass - sets sessionid cookie)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });\r\npm.test('Status is 200', function () { pm.response.to.have.status(200); });\r\n\r\nvar csrfCookie = postman.getResponseCookie(\"csrftoken\");\r\nif (csrfCookie) {\r\n    pm.environment.set(\"csrftoken\", csrfCookie.value);\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/session-auth/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "session-auth",
                "login",
                ""
              ]
            },
            "description": "Postman's cookie jar stores the sessionid cookie automatically; later requests to the same host resend it without any extra setup."
